# Copy to keystore.properties (gitignored) after creating a release keystore:
#
#   keytool -genkey -v -keystore quickmarks-release.keystore -alias quickmarks \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../quickmarks-release.keystore
storePassword=your-store-password
keyAlias=quickmarks
keyPassword=your-key-password
